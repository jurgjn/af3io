
Bootstrap: docker
From: ghcr.io/astral-sh/uv:0.12.17
Stage: uv_stage

Bootstrap: docker
From: nvidia/cuda:13.4.3-base-ubuntu26.04

%files from uv_stage
    # https://docs.astral.sh/uv/guides/integration/docker/#installing-uv
    # copying the binary from the official distroless Docker image
    /uv /bin/
    /uvx /bin/

%post
    export DEBIAN_FRONTEND=noninteractive
    # build-essential needed for numba compilation such as pooled-ppi
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        fd-find \
        git \
        less \
        ripgrep \
        squashfs-tools \
        zstd

    # nodejs v24 is LTS: https://nodejs.org/en/about/previous-releases 
    # install from NodeSource PPA: https://nodesource.com/products/distributions
    curl -fsSL https://deb.nodesource.com/setup_24.x | bash -
    apt-get update && apt-get install -y --no-install-recommends \
        nodejs

    # pi auto-downloads rg/fd at startup unless found on PATH;
    # apt's fd-find only installs `fdfind`, so symlink it
    ln -sf /usr/bin/fdfind /usr/local/bin/fd

    # apt-get cleanup
    rm -rf /var/lib/apt/lists/* && apt-get clean

    # https://github.com/earendil-works/pi/tree/main/packages/coding-agent#quick-start
    npm install -g --ignore-scripts @earendil-works/pi-coding-agent

    # Python 3.13 (uv-managed, independent of the system Python) with af3io runtime + test dependencies
    # (keep in sync with pyproject.toml); af3io itself is used from the mounted working copy
    export UV_PYTHON_INSTALL_DIR=/opt/uv-python
    uv venv --python 3.13 /opt/venv
    uv pip install --python /opt/venv/bin/python --no-cache \
        click \
        humanfriendly \
        scipy \
        pandas \
        zarr \
        biopython \
        pyarrow \
        backports.zstd \
        pytest \
        pytest-cov \
        pooch

%environment
    export PATH=/opt/venv/bin:$PATH

%test
    rg --version | head -1
    fd --version
    uv --version
    node -v
    npm -v
    pi --version
    python --version
    pytest --version

%runscript
    set -eu
    exec pi "$@"

%labels
    BuildCommand apptainer build --force sandbox.sif sandbox.def
